      "type": "string"
    },
    {
      "key": "signerName",
      "value": "Sample Signer",
      "type": "string"
    },
    {
      "key": "signerLocation",
      "value": "Philippines",
      "type": "string"
    },
    {
      "key": "signReason",
      "value": "Approved",
      "type": "string"
    },
    {
      "key": "confirmRemoval",
      "value": "false",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let folder = pm.variables.get('projectFolder');",
          "if (!folder || !String(folder).trim()) {",
          "  folder = 'idms-staging-' + pm.variables.replaceIn('{{$guid}}');",
          "  if (pm.environment.name) { pm.environment.set('projectFolder', folder); }",
          "  else { pm.collectionVariables.set('projectFolder', folder); }",
          "}",
          "pm.variables.set('projectFolder', folder);",
          "if (!/^[a-zA-Z0-9_-]+$/.test(folder)) {",
          "  throw new Error('Use letters, numbers, hyphens, or underscores for projectFolder. Keep this value unchanged after your first upload.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Main workflow",
      "item": [
        {
          "name": "01 Check service availability",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Send this first to check that the staging API responds.",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "02 Save certificate and signature image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Project-Key",
                "value": "{{projectFolder}}"
              }
            ],
            "description": "Choose your own PNPKI .p12 file and signature image in Body > form-data. The image is optional for digital signing but required for saved-image signing. Uploading again replaces the active profile for this project and user.",
            "url": {
              "raw": "{{baseUrl}}/certificates/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "certificates",
                "upload"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "projectFolder",
                  "value": "{{projectFolder}}",
                  "type": "text"
                },
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "p12File",
                  "type": "file",
                  "src": [],
                  "description": "Choose a valid PNPKI certificate."
                },
                {
                  "key": "signatureImageFile",
                  "type": "file",
                  "src": [],
                  "description": "Choose the image to save with the profile."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('password')) {",
                  "  throw new Error('Set password locally in your selected Postman environment before sending this request. Do not export real credentials.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
                ]
              }
            }
          ],
          "response": []
        },
