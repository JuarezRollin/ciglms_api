{
  "info": {
    "_postman_id": "78ca61b1-d66c-4306-a8e9-ff981220c32a",
    "name": "DSWD PDF Signing API Consumer Guide Staging",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "For API users integrating with https://pdf-signer-staging.dswd.gov.ph. Import this collection and the companion environment, then select that environment. projectFolder starts blank: the first request generates and saves a unique idms-staging UUID value. Generate it ONCE and reuse it for all requests from the same integration. Never reuse another team's existing folder; keep staging and production separate. X-Project-Key must match projectFolder. Set userId and password locally, and select files in each form-data body. No real credentials or internal file paths are included. Signing returns a PDF; save the response only after checking HTTP 200. Requests are meant to be sent individually, not as an unattended collection run. Removal is kept in a separate folder and disabled until confirmRemoval is true. No service-token setup is included in this consumer collection."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://pdf-signer-staging.dswd.gov.ph",
      "type": "string"
    },
    {
      "key": "projectFolder",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "user-1",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "pageIndex",
      "value": "0",
      "type": "string"
    },
    {
      "key": "x",
      "value": "120",
      "type": "string"
    },
    {
      "key": "y",
