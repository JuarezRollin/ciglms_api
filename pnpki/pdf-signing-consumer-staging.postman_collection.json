            "header": [
              {
                "key": "X-Project-Key",
                "value": "{{projectFolder}}"
              }
            ],
            "description": "Set userId and password for the second signer, whose certificate must already be uploaded to the same project. Choose step1.pdf from the previous request as pdfFile and save the response as step2.pdf. The file is not transferred automatically.",
            "url": {
              "raw": "{{baseUrl}}/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sign"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "projectFolder",
                  "value": "{{projectFolder}}",
                  "type": "text"
                },
                {
                  "key": "userId",
                  "value": "{{userId}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "signatureMode",
                  "value": "digital",
                  "type": "text"
                },
                {
                  "key": "pdfFile",
                  "type": "file",
                  "src": [],
                  "description": "Choose step1.pdf, not the original PDF."
                },
                {
                  "key": "pageIndex",
                  "value": "0",
                  "type": "text"
                },
                {
                  "key": "x",
                  "value": "120",
                  "type": "text"
                },
                {
                  "key": "y",
                  "value": "180",
                  "type": "text"
                },
                {
                  "key": "width",
                  "value": "210",
                  "type": "text"
                },
                {
                  "key": "height",
                  "value": "90",
                  "type": "text"
                },
                {
                  "key": "fieldName",
                  "value": "Signature2",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('password')) {",
                  "  throw new Error('Set password locally in your selected Postman environment before sending this request. Do not export real credentials.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PDF returned successfully', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf');",
                  "});",
                  "pm.test('Signing mode returned', function () {",
                  "  pm.expect(pm.response.headers.get('X-Signature-Mode')).to.be.oneOf(['digital', 'electronic']);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Certificate removal send manually",
      "item": [
        {
          "name": "Remove active saved certificate",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Project-Key",
                "value": "{{projectFolder}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "description": "Use only when you intend to remove the active profile. It is archived into history. Set confirmRemoval=true locally to allow this request, and reset it afterwards.",
            "url": {
              "raw": "{{baseUrl}}/certificates/remove?projectFolder={{projectFolder}}&userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "certificates",
                "remove"
              ],
              "query": [
                {
                  "key": "projectFolder",
                  "value": "{{projectFolder}}"
                },
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('password')) {",
                  "  throw new Error('Set password locally in your selected Postman environment before sending this request. Do not export real credentials.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (String(pm.variables.get('confirmRemoval')) !== 'true') {",
                  "  throw new Error('Removal is disabled. Set confirmRemoval=true locally only when you intend to remove this active certificate.');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
